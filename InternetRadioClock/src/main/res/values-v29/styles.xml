<resources>

    <!-- API 29+ opt-out of force dark: the app ships a deliberate light theme and
         its own night profile, so the system must not auto-invert it. -->
    <style name="AppBaseTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- My Radio List: its cards and add button need a Material Components theme. -->
    <style name="RadioListTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

</resources>
