<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12 and above (dataExtractionRules).
  Everything is backed up / transferred except dialog_flags.xml, which holds the one-shot "new stuff"
  and AMOLED flags: a restored or transferred install has to look like a first install to those
  dialogs.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="dialog_flags.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="dialog_flags.xml" />
    </device-transfer>
</data-extraction-rules>
