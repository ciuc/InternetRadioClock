<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="88dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <!-- the memory button this station sits on -->
        <TextView
            android:id="@+id/station_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/station_badge"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/station_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadline6"
                tools:text="GRL" />

            <TextView
                android:id="@+id/station_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBody2"
                tools:text="Radio Guerrilla" />

            <TextView
                android:id="@+id/station_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                tools:text="http://live.guerrillaradio.ro:8010/guerrilla.aac" />

            <TextView
                android:id="@+id/station_off_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/radio_list_not_on_clock"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textStyle="italic"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/station_move_up"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/radio_list_move_up"
            app:srcCompat="@drawable/ic_arrow_up_24" />

        <ImageButton
            android:id="@+id/station_move_down"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/radio_list_move_down"
            app:srcCompat="@drawable/ic_arrow_down_24" />

        <ImageButton
            android:id="@+id/station_remove"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/radio_list_remove"
            app:srcCompat="@drawable/ic_delete_24" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
