<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:padding="5dp"
    android:layout_marginBottom="5pt"
    android:orientation="vertical"
    android:background="@drawable/stream"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <!-- wrap_content row + weighted title: the play button sits right after the title, and a
         long title shrinks (instead of pushing the button off screen) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:text="RockFM"
            android:textColor="@color/colorPrimaryDark" />

        <ImageButton
            android:id="@+id/sf_preview_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/preview_stream"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_play_circle_outline_24"
            android:tint="@color/colorPrimaryDark" />

        <TextView
            android:id="@+id/sf_preview_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/preview_checking"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/radio_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">
    <TextView
        android:id="@+id/radio_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[FROM: Romania | IN: Romanian | PLAYING: Rock,Pop, indie rock, indie pop, alternative, contemproary]"
        android:textColor="#000000"/>
    </LinearLayout>
    <!-- the label gets a line of its own: next to eight buttons it overflows narrow screens -->
    <TextView
        android:id="@+id/sf_replace_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/assign_to"
        android:textColor="#000000"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
    <Button
        android:id="@+id/sf_assign_button_stream1"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:text="@string/button.name.stream1"
                android:background="@drawable/memory"
        android:textColor="@color/button.color.off" />
    <Button
        android:id="@+id/sf_assign_button_stream2"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:text="@string/button.name.stream2"
                android:background="@drawable/memory"
        android:textColor="@color/button.color.off" />
    <Button
        android:id="@+id/sf_assign_button_stream3"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:text="@string/button.name.stream3"
                android:background="@drawable/memory"
        android:textColor="@color/button.color.off" />
    <Button
        android:id="@+id/sf_assign_button_stream4"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:text="@string/button.name.stream4"
                android:background="@drawable/memory"
        android:textColor="@color/button.color.off" />
    <Button
        android:id="@+id/sf_assign_button_stream5"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:text="@string/button.name.stream5"
                android:background="@drawable/memory"
        android:textColor="@color/button.color.off" />
    <Button
        android:id="@+id/sf_assign_button_stream6"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:text="@string/button.name.stream6"
                android:background="@drawable/memory"
        android:textColor="@color/button.color.off" />
    <Button
        android:id="@+id/sf_assign_button_stream7"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:text="@string/button.name.stream7"
                android:background="@drawable/memory"
        android:textColor="@color/button.color.off" />
    <Button
        android:id="@+id/sf_assign_button_stream8"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:text="@string/button.name.stream8"
                android:background="@drawable/memory"
        android:textColor="@color/button.color.off" />
    <!-- adds the stream at the end of My Radio List -->
    <Button
        android:id="@+id/sf_add_button"
        style="@style/imageButtonStyle"
        android:layout_width="@dimen/streamFinder.button"
        android:layout_height="@dimen/streamFinder.button"
        android:layout_marginTop="@dimen/assign_to_mem_button_margin_top"
        android:layout_marginLeft="@dimen/assign_to_mem_button_margin_left"
        android:background="@drawable/memory"
        android:contentDescription="@string/sf_add_station"
        android:padding="0dp"
        android:text="+"
        android:textColor="@color/colorAccent"
        android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>